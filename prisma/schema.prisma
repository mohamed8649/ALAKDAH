// ALAKDAH — Arabic-first commerce SaaS platform.
//
// Conventions enforced across this schema:
//  * Money is stored as INTEGER MINOR UNITS (see src/lib/money.ts). LYD has 3
//    minor digits, so 235.000 LYD is stored as 235000. Never a float.
//  * Every tenant-owned row carries `storeId`. Queries must derive that id from
//    the authorised session, never from request input.
//  * Timestamps are stored as UTC `timestamptz` and rendered in the store's
//    timezone (default Africa/Tripoli).
//  * Entities referenced by order history use soft deletion (`archivedAt`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  locale       String  @default("ar")
  isActive     Boolean @default(true)

  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedStores  Store[]        @relation("StoreOwner")
  memberships  StoreMember[]
  sessions     UserSession[]
  auditLogs    AuditLog[]
  notifications Notification[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ---------------------------------------------------------------------------
// Stores & tenancy
// ---------------------------------------------------------------------------

model Store {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  ownerId     String

  logoUrl    String?
  faviconUrl String?
  phone      String?
  email      String?

  instagram String?
  facebook  String?
  tiktok    String?
  telegram  String?
  whatsapp  String?

  defaultLocale String @default("ar")
  currency      String @default("LYD")
  timezone      String @default("Africa/Tripoli")
  country       String @default("LY")

  status StoreStatus @default(ACTIVE)

  // Storefront design
  primaryColor   String  @default("#00B77B")
  secondaryColor String  @default("#0B1929")
  fontFamily     String  @default("ibm-plex-arabic")
  announcementText    String?
  announcementEnabled Boolean @default(false)

  customDomain String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User          @relation("StoreOwner", fields: [ownerId], references: [id])
  members StoreMember[]

  products         Product[]
  categories       Category[]
  collections      Collection[]
  customers        Customer[]
  orders           Order[]
  agents           Agent[]
  agentRules       AgentAssignmentRule[]
  shippingMethods  ShippingMethod[]
  shippingProviders ShippingProvider[]
  shippingRules    ShippingRule[]
  shippingZones    ShippingZone[]
  campaigns        Campaign[]
  checkoutFields   CheckoutField[]
  customFields     CustomField[]
  trustBadges      TrustBadge[]
  landingPages     LandingPage[]
  appInstalls      AppInstallation[]
  pixels           PixelIntegration[]
  integrations     IntegrationConnection[]
  importJobs       ImportJob[]
  accessTokens     AccessToken[]
  auditLogs        AuditLog[]
  abandoned        AbandonedCheckout[]
  blockedIps       BlockedIp[]
  themeConfig      StoreTheme?
  settings         StoreSettings?
  subscription     Subscription?
  aiGenerations    AiGeneration[]
  inventoryMoves   InventoryMovement[]
  analyticsEvents  AnalyticsEvent[]
  notifications    Notification[]
  deliverySlip     DeliverySlipConfig?
  jobs             BackgroundJob[]

  @@index([ownerId])
  @@map("stores")
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique

  // Cart / checkout behaviour
  cartEnabled            Boolean @default(true)
  guestCheckoutOnly      Boolean @default(true)
  requireOrderConfirmation Boolean @default(true)

  // Thank-you popup
  thankYouEnabled    Boolean @default(true)
  thankYouTitle      String  @default("شكراً لطلبك!")
  thankYouMessage    String  @default("سنتواصل معك قريباً لتأكيد الطلب.")
  thankYouButtonText String  @default("متابعة التسوق")
  thankYouButtonUrl  String?

  // Quick contact
  quickContactPhoneEnabled    Boolean @default(false)
  quickContactPhone           String?
  quickContactWhatsappEnabled Boolean @default(false)
  quickContactWhatsapp        String?
  quickContactCountryCode     String  @default("+218")

  // Order tracking
  trackingEnabled Boolean         @default(true)
  trackingMethod  TrackingMethod  @default(ORDER_NUMBER_AND_PHONE)

  // Fraud / duplicate protection
  fraudProtectionEnabled Boolean       @default(false)
  fraudMaxOrders         Int           @default(3)
  fraudWindowHours       Int           @default(24)
  fraudAction            FraudAction   @default(FLAG)

  // Abandoned checkout tracking
  abandonedTrackingEnabled Boolean @default(false)

  // Notifications
  notificationsEnabled Boolean @default(true)
  notificationSound    Boolean @default(true)
  notificationVolume   Int     @default(70)
  notifyOnNewOrder     Boolean @default(true)
  notifyOnConfirmed    Boolean @default(false)
  notifyOnShipped      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

enum TrackingMethod {
  ORDER_NUMBER_AND_PHONE
  PHONE_ONLY
  ORDER_NUMBER_ONLY
}

enum FraudAction {
  BLOCK
  FLAG
  ALLOW
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model StoreMember {
  id       String @id @default(cuid())
  storeId  String
  userId   String
  roleKey  String
  isActive Boolean @default(true)

  invitedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleKey], references: [key])

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model Role {
  key         String  @id
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean @default(true)
  rank        Int     @default(0)

  permissions RolePermission[]
  members     StoreMember[]

  @@map("roles")
}

model RolePermission {
  roleKey       String
  permissionKey String

  role Role @relation(fields: [roleKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(cuid())
  storeId  String
  name     String
  slug     String
  parentId String?
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

model Collection {
  id          String  @id @default(cuid())
  storeId     String
  title       String
  titleEn     String?
  handle      String
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products ProductCollection[]

  @@unique([storeId, handle])
  @@index([storeId])
  @@map("collections")
}

model Product {
  id      String @id @default(cuid())
  storeId String

  name             String
  nameEn           String?
  slug             String
  sku              String?
  description      String?
  shortDescription String?

  status     ProductStatus     @default(DRAFT)
  visibility ProductVisibility @default(VISIBLE)

  // Money in minor units
  price          Int
  compareAtPrice Int?
  cost           Int?

  hasVariants Boolean @default(false)

  // Inventory (simple products; variable products aggregate from variants)
  trackInventory     Boolean @default(true)
  stockQuantity      Int     @default(0)
  lowStockThreshold  Int     @default(5)
  allowBackorder     Boolean @default(false)

  // Shipping
  weightGrams      Int?
  shippingRequired Boolean @default(true)
  freeShipping     Boolean @default(false)

  // Offers
  upsellEnabled     Boolean @default(false)
  upsellTitle       String?
  upsellDescription String?

  // SEO
  seoTitle       String?
  seoDescription String?

  tags String[] @default([])

  viewCount Int @default(0)

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  categories  ProductCategory[]
  collections ProductCollection[]
  orderItems  OrderItem[]
  agentRules  AgentAssignmentRule[]
  campaigns   CampaignProduct[]
  offers      ProductOffer[]
  inventoryMoves InventoryMovement[]
  landingPages   LandingPage[]

  relatedFrom RelatedProduct[] @relation("RelatedSource")
  relatedTo   RelatedProduct[] @relation("RelatedTarget")

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, archivedAt])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVisibility {
  VISIBLE
  HIDDEN
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)
  width     Int?
  height    Int?
  sizeBytes Int?

  createdAt DateTime @default(now())

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId])
  @@map("product_images")
}

model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String
  position Int    @default(0)

  option    ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selections VariantOptionValue[]

  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  // Deterministic identity: sorted optionValueIds joined by ":".
  // Guarantees the generator never produces duplicates.
  signature String

  title          String
  sku            String?
  barcode        String?
  price          Int?
  compareAtPrice Int?
  cost           Int?
  stockQuantity  Int     @default(0)
  imageId        String?
  isActive       Boolean @default(true)
  position       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  image     ProductImage?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  optionValues VariantOptionValue[]
  orderItems OrderItem[]
  inventoryMoves InventoryMovement[]

  @@unique([productId, signature])
  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model RelatedProduct {
  productId String
  relatedId String
  position  Int @default(0)

  product Product @relation("RelatedSource", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId])
  @@map("related_products")
}

model ProductOffer {
  id        String    @id @default(cuid())
  productId String
  type      OfferType @default(QUANTITY_DISCOUNT)
  title     String
  minQuantity Int     @default(2)
  // Either a percentage (0-100) or a fixed price in minor units.
  discountPercent Int?
  fixedPrice      Int?
  isActive  Boolean   @default(true)
  position  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_offers")
}

enum OfferType {
  QUANTITY_DISCOUNT
  BUNDLE_PRICE
  FREE_SHIPPING
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model InventoryMovement {
  id        String @id @default(cuid())
  storeId   String
  productId String
  variantId String?

  delta      Int
  balance    Int
  reason     InventoryReason
  reference  String?
  note       String?
  actorId    String?

  createdAt DateTime @default(now())

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([productId])
  @@map("inventory_movements")
}

enum InventoryReason {
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_RETURNED
  RESTOCK
  IMPORT
  CORRECTION
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id      String @id @default(cuid())
  storeId String

  name  String
  // Canonical E.164-ish representation used for matching and duplicate checks.
  phone String
  phoneRaw String?
  email String?

  notes String?
  tags  String[] @default([])

  ordersCount Int @default(0)
  totalSpent  Int @default(0)
  lastOrderAt DateTime?

  isBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  @@unique([storeId, phone])
  @@index([storeId, createdAt])
  @@map("customers")
}

model CustomerAddress {
  id         String  @id @default(cuid())
  customerId String
  label      String?
  state      String
  city       String
  address    String
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  storeId     String
  orderNumber String

  customerId String?

  status         OrderStatus    @default(NEW)
  paymentStatus  PaymentStatus  @default(PENDING)
  paymentMethod  PaymentMethod  @default(COD)
  shippingStatus ShippingStatus @default(NOT_SHIPPED)

  subtotal       Int
  discountAmount Int @default(0)
  shippingAmount Int @default(0)
  total          Int
  currency       String @default("LYD")

  source OrderSource @default(STOREFRONT)

  assignedAgentId    String?
  shippingProviderId String?
  shippingMethodId   String?
  campaignId         String?
  landingPageId      String?

  customerName  String
  customerPhone String
  customerPhoneRaw String?
  customerEmail String?

  state   String
  city    String
  address String

  notes         String?
  internalNotes String?
  tags          String[] @default([])
  customFields  Json?

  trackingNumber String?
  cancelReason   String?

  // Fraud signals
  riskFlagged Boolean @default(false)
  riskReason  String?
  ipAddress   String?

  // Optimistic concurrency
  version Int @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  returnedAt  DateTime?

  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedAgent  Agent?            @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  shippingProvider ShippingProvider? @relation(fields: [shippingProviderId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod?   @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  campaign       Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  items   OrderItem[]
  history OrderStatusHistory[]
  abandonedFrom AbandonedCheckout[]

  @@unique([storeId, orderNumber])
  @@index([storeId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([storeId, customerPhone])
  @@index([storeId, assignedAgentId])
  @@map("orders")
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  READY_FOR_SHIPPING
  SHIPPED
  DELIVERED
  CANCELLED
  DELIVERY_FAILED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CARD
}

enum ShippingStatus {
  NOT_SHIPPED
  READY
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum OrderSource {
  STOREFRONT
  LANDING_PAGE
  MANUAL
  CALL_CENTER
  IMPORT
  API
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String?
  variantId String?

  // Snapshots — an order must render correctly even if the product is gone.
  nameSnapshot    String
  skuSnapshot     String?
  variantSnapshot String?
  imageSnapshot   String?

  unitPrice Int
  quantity  Int
  total     Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String

  fromStatus OrderStatus?
  toStatus   OrderStatus

  actorType ActorType @default(USER)
  actorId   String?
  actorName String?

  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  CUSTOMER
  API
}

// ---------------------------------------------------------------------------
// Call center
// ---------------------------------------------------------------------------

model Agent {
  id      String @id @default(cuid())
  storeId String

  fullName     String
  email        String?
  username     String
  passwordHash String

  isActive Boolean @default(true)
  roleKey  String  @default("call_center_agent")

  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders   Order[]
  rules    AgentAssignmentRule[]
  sessions AgentSession[]

  @@unique([storeId, username])
  @@index([storeId])
  @@map("agents")
}

model AgentSession {
  id        String    @id @default(cuid())
  agentId   String
  tokenHash String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_sessions")
}

model AgentAssignmentRule {
  id      String @id @default(cuid())
  storeId String

  name      String
  agentId   String
  productId String?

  // When productId is null the rule matches every product (catch-all).
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, priority])
  @@map("agent_assignment_rules")
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

model ShippingProvider {
  id      String @id @default(cuid())
  storeId String

  providerKey String
  name        String
  isConnected Boolean @default(false)
  isActive    Boolean @default(true)

  // AES-256-GCM ciphertext. Never returned to the browser after saving.
  credentialsEncrypted String?
  lastTestedAt         DateTime?
  lastTestStatus       String?
  lastTestMessage      String?

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store  Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]
  rules  ShippingRule[]

  @@unique([storeId, providerKey])
  @@index([storeId])
  @@map("shipping_providers")
}

model ShippingMethod {
  id      String @id @default(cuid())
  storeId String

  name        String
  nameEn      String?
  description String?
  type        ShippingMethodType @default(DELIVERY)

  price     Int     @default(0)
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  supportsCod Boolean @default(true)

  minDeliveryDays Int?
  maxDeliveryDays Int?

  position Int @default(0)

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store  Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zones  ShippingZone[]
  orders Order[]

  @@index([storeId])
  @@map("shipping_methods")
}

enum ShippingMethodType {
  DELIVERY
  PICKUP
  EXPRESS
}

model ShippingZone {
  id       String @id @default(cuid())
  storeId  String
  methodId String

  name     String
  price    Int
  // Empty regions array = fallback zone for the method.
  regions  String[] @default([])
  cities   String[] @default([])
  position Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([methodId])
  @@map("shipping_zones")
}

model ShippingRule {
  id      String @id @default(cuid())
  storeId String

  name     String
  priority Int     @default(0)
  isActive Boolean @default(true)

  // Conditions — all non-null conditions must match (AND).
  matchState      String?
  matchCity       String?
  matchMinTotal   Int?
  matchMaxTotal   Int?
  matchMethodType ShippingMethodType?

  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider ShippingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([storeId, priority])
  @@map("shipping_rules")
}

model DeliverySlipConfig {
  id      String @id @default(cuid())
  storeId String @unique

  showCodAmount     Boolean @default(true)
  showCustomerName  Boolean @default(true)
  showPhone         Boolean @default(true)
  showAddress       Boolean @default(true)
  showProducts      Boolean @default(true)
  showQuantities    Boolean @default(true)
  showNotes         Boolean @default(true)
  showLogo          Boolean @default(true)
  showStoreInfo     Boolean @default(true)
  showSignatureLines Boolean @default(false)
  showOrderNumber   Boolean @default(true)
  showBarcode       Boolean @default(false)

  language  String @default("ar")
  paperSize String @default("A5")
  footerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("delivery_slip_configs")
}

// ---------------------------------------------------------------------------
// Checkout configuration
// ---------------------------------------------------------------------------

model CheckoutField {
  id      String @id @default(cuid())
  storeId String

  fieldKey String
  mode     FieldMode @default(REQUIRED)
  position Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fieldKey])
  @@map("checkout_fields")
}

enum FieldMode {
  REQUIRED
  OPTIONAL
  HIDDEN
}

model CustomField {
  id      String @id @default(cuid())
  storeId String

  label       String
  fieldKey    String
  type        CustomFieldType @default(TEXT)
  placeholder String?
  helpText    String?
  required    Boolean @default(false)
  options     String[] @default([])
  position    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fieldKey])
  @@map("custom_fields")
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  SELECT
  RADIO
  CHECKBOX
  NUMBER
}

model TrustBadge {
  id      String @id @default(cuid())
  storeId String

  title       String
  description String?
  icon        String  @default("shield")
  isActive    Boolean @default(true)
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("trust_badges")
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Campaign {
  id      String @id @default(cuid())
  storeId String

  name            String
  discountPercent Int
  startAt         DateTime
  endAt           DateTime
  isActive        Boolean @default(true)
  appliesToAll    Boolean @default(false)

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products CampaignProduct[]
  orders   Order[]

  @@index([storeId, startAt, endAt])
  @@map("campaigns")
}

model CampaignProduct {
  campaignId String
  productId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@map("campaign_products")
}

model AbandonedCheckout {
  id      String @id @default(cuid())
  storeId String

  sessionId     String
  customerName  String?
  customerPhone String?
  state         String?
  city          String?

  cart          Json
  value         Int     @default(0)
  checkoutStep  String  @default("started")
  status        AbandonedStatus @default(OPEN)

  convertedOrderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store           Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  convertedOrder  Order? @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@unique([storeId, sessionId])
  @@index([storeId, createdAt])
  @@map("abandoned_checkouts")
}

enum AbandonedStatus {
  OPEN
  RECOVERED
  DISMISSED
}

model BlockedIp {
  id      String @id @default(cuid())
  storeId String

  ip        String
  reason    String?
  createdBy String?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, ip])
  @@map("blocked_ips")
}

// ---------------------------------------------------------------------------
// Pixels, analytics & integrations
// ---------------------------------------------------------------------------

model PixelIntegration {
  id      String @id @default(cuid())
  storeId String

  providerKey String
  pixelId     String
  isActive    Boolean @default(false)
  // Which internal events forward to this provider, and under which name.
  eventMapping Json?
  accessTokenEncrypted String?
  validatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, providerKey])
  @@map("pixel_integrations")
}

model AnalyticsEvent {
  id      String @id @default(cuid())
  storeId String

  name      String
  sessionId String?
  productId String?
  orderId   String?
  value     Int?
  payload   Json?
  path      String?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, name, createdAt])
  @@index([storeId, productId])
  @@map("analytics_events")
}

model IntegrationConnection {
  id      String @id @default(cuid())
  storeId String

  providerKey String
  name        String
  status      IntegrationStatus @default(DISCONNECTED)

  credentialsEncrypted String?
  config               Json?
  // Google Sheets style column mapping: { platformField: sheetColumn }
  fieldMapping         Json?

  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastSyncMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, providerKey])
  @@map("integration_connections")
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model ImportJob {
  id      String @id @default(cuid())
  storeId String

  source     String
  status     ImportJobStatus @default(PENDING)
  totalRows  Int             @default(0)
  imported   Int             @default(0)
  skipped    Int             @default(0)
  failed     Int             @default(0)
  payload    Json?
  createdBy  String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rows  ImportRow[]

  @@index([storeId, createdAt])
  @@map("import_jobs")
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model ImportRow {
  id       String @id @default(cuid())
  jobId    String
  rowIndex Int
  status   ImportRowStatus @default(PENDING)
  data     Json
  error    String?
  createdEntityId String?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_rows")
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  SKIPPED
  FAILED
}

// ---------------------------------------------------------------------------
// Apps
// ---------------------------------------------------------------------------

model AppDefinition {
  key         String  @id
  nameAr      String
  nameEn      String
  descriptionAr String
  descriptionEn String
  category    String  @default("general")
  icon        String  @default("puzzle")
  settingsRoute String?
  isCore      Boolean @default(false)
  requiredFeature String?
  position    Int     @default(0)

  installations AppInstallation[]

  @@map("app_definitions")
}

model AppInstallation {
  id      String @id @default(cuid())
  storeId String
  appKey  String

  isEnabled Boolean @default(false)
  settings  Json?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  app   AppDefinition @relation(fields: [appKey], references: [key], onDelete: Cascade)

  @@unique([storeId, appKey])
  @@map("app_installations")
}

// ---------------------------------------------------------------------------
// Landing pages
// ---------------------------------------------------------------------------

model LandingPage {
  id      String @id @default(cuid())
  storeId String

  title     String
  slug      String
  productId String?

  status PageStatus @default(DRAFT)

  // PageDocument — { version, blocks: [{ id, type, props }] }.
  // Never store JSX or executable JavaScript here.
  document Json

  seoTitle       String?
  seoDescription String?
  locale         String @default("ar")

  views       Int @default(0)
  conversions Int @default(0)

  generatedByAi Boolean @default(false)
  aiPreset      String?

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@map("landing_pages")
}

enum PageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// ---------------------------------------------------------------------------
// Themes
// ---------------------------------------------------------------------------

model ThemeDefinition {
  key         String @id
  nameAr      String
  nameEn      String
  descriptionAr String?
  previewImage String?
  version     String @default("1.0.0")
  // Default token overrides and section composition for this theme.
  tokens      Json
  sections    Json
  isPremium   Boolean @default(false)
  position    Int     @default(0)

  stores StoreTheme[]

  @@map("theme_definitions")
}

model StoreTheme {
  id      String @id @default(cuid())
  storeId String @unique

  themeKey String
  // Merchant overrides layered on top of ThemeDefinition.tokens.
  tokenOverrides   Json?
  sectionOverrides Json?
  installedThemes  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  theme ThemeDefinition @relation(fields: [themeKey], references: [key])

  @@map("store_themes")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Plan {
  key         String @id
  nameAr      String
  nameEn      String
  descriptionAr String?
  // Money in minor units of `currency`.
  monthlyPrice Int
  yearlyPrice  Int
  currency     String @default("LYD")
  isPayg       Boolean @default(false)
  position     Int    @default(0)
  isActive     Boolean @default(true)

  features PlanFeature[]
  limits   PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanFeature {
  planKey    String
  featureKey String
  enabled    Boolean @default(true)

  plan Plan @relation(fields: [planKey], references: [key], onDelete: Cascade)

  @@id([planKey, featureKey])
  @@map("plan_features")
}

model PlanLimit {
  planKey  String
  limitKey String
  // -1 means unlimited.
  value    Int

  plan Plan @relation(fields: [planKey], references: [key], onDelete: Cascade)

  @@id([planKey, limitKey])
  @@map("plan_limits")
}

model Subscription {
  id      String @id @default(cuid())
  storeId String @unique
  planKey String

  status    SubscriptionStatus @default(TRIALING)
  interval  BillingInterval    @default(MONTHLY)

  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan    Plan           @relation(fields: [planKey], references: [key])
  usage   UsageCounter[]
  addOns  AddOnPurchase[]

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model UsageCounter {
  id             String @id @default(cuid())
  subscriptionId String
  limitKey       String
  used           Int    @default(0)
  periodStart    DateTime
  periodEnd      DateTime

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, limitKey, periodStart])
  @@map("usage_counters")
}

model AddOn {
  key      String @id
  nameAr   String
  nameEn   String
  limitKey String
  quantity Int
  price    Int
  currency String @default("LYD")
  isActive Boolean @default(true)

  purchases AddOnPurchase[]

  @@map("add_ons")
}

model AddOnPurchase {
  id             String @id @default(cuid())
  subscriptionId String
  addOnKey       String
  quantity       Int    @default(1)
  remaining      Int    @default(0)

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addOn        AddOn        @relation(fields: [addOnKey], references: [key])

  @@index([subscriptionId])
  @@map("add_on_purchases")
}

// ---------------------------------------------------------------------------
// Access tokens, audit & notifications
// ---------------------------------------------------------------------------

model AccessToken {
  id      String @id @default(cuid())
  storeId String

  name        String
  prefix      String
  hashedToken String @unique
  scopes      String[] @default([])

  createdBy  String?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("access_tokens")
}

model AuditLog {
  id      String @id @default(cuid())
  storeId String

  actorType ActorType @default(USER)
  actorId   String?
  actorName String?
  userId    String?

  action     String
  entityType String
  entityId   String?

  before   Json?
  after    Json?
  metadata Json?
  ip       String?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id      String @id @default(cuid())
  storeId String
  userId  String?

  type     String
  titleAr  String
  bodyAr   String?
  link     String?
  severity String  @default("info")
  readAt   DateTime?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// AI
// ---------------------------------------------------------------------------

model AiGeneration {
  id      String @id @default(cuid())
  storeId String

  kind     AiGenerationKind
  provider String
  model    String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  // Estimated cost in USD micro-units (1_000_000 = $1).
  costMicros   Int @default(0)
  creditsUsed  Int @default(1)

  status       AiGenerationStatus @default(PENDING)
  errorMessage String?

  resourceType String?
  resourceId   String?

  requestedBy String?
  prompt      Json?
  result      Json?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("ai_generations")
}

enum AiGenerationKind {
  PRODUCT_DESCRIPTION
  LANDING_PAGE
  LOGO
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// ---------------------------------------------------------------------------
// Background jobs
// ---------------------------------------------------------------------------

model BackgroundJob {
  id      String @id @default(cuid())
  storeId String?

  kind        String
  status      JobStatus @default(QUEUED)
  payload     Json
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)

  runAt      DateTime @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@map("background_jobs")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}
